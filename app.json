{
  "expo": {
    "name": "Controle Remoto",
    "slug": "remote-control-universal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.fbsystems.controleremoto",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "O app usa a rede local para encontrar e controlar sua TV.",
        "NSBonjourServices": [
          "_androidtvremote2._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.fbsystems.controleremoto"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "react-native-quick-crypto"
    ],
    "scheme": "controleremoto",
    "experiments": {
      "typedRoutes": true
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
